plt.show()


# 13. Raisin Class Distribution Pie Chart

class_counts = df['Class'].value_counts()

plt.figure(figsize=(7, 7))
plt.pie(
    class_counts,
    labels=class_counts.index,
    autopct="%1.1f%%",
    startangle=90
)

plt.title("Raisin Class Distribution")
